        <mxCell id="title" value="CLIENTA — Architecture AWS 3-tiers (cible du Livrable 2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="note" value="Région us-east-1 | Terraform | HTTP/80 pour la démonstration | Ressources à valider dans AWS Academy Learner Lab" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#42526E;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1200" height="30" as="geometry"/></mxCell>

