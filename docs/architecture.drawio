        <mxCell id="appsub2" value="Sous-réseau privé applicatif — 10.0.12.0/24" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#36A886;fillColor=#EFFAF6;verticalAlign=top;spacingTop=8;fontSize=12;fontColor=#17634D;" vertex="1" parent="1"><mxGeometry x="905" y="405" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="datasub1" value="Sous-réseau privé données — 10.0.21.0/24" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#6495ED;fillColor=#F0F5FF;verticalAlign=top;spacingTop=8;fontSize=12;fontColor=#24476B;" vertex="1" parent="1"><mxGeometry x="465" y="575" width="390" height="165" as="geometry"/></mxCell>
        <mxCell id="datasub2" value="Sous-réseau privé données — 10.0.22.0/24" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#6495ED;fillColor=#F0F5FF;verticalAlign=top;spacingTop=8;fontSize=12;fontColor=#24476B;" vertex="1" parent="1"><mxGeometry x="905" y="575" width="390" height="165" as="geometry"/></mxCell>

        <mxCell id="igw" value="Internet&#xa;Gateway" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#607D8B;fillColor=#ECEFF1;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="100" height="55" as="geometry"/></mxCell>
        <mxCell id="alb" value="Application Load Balancer&#xa;Public, multi-AZ | Listener :80&#xa;Health check : GET /health&#xa;SG-ALB : TCP 80 depuis Internet" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#D79B00;fillColor=#FFE6A6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="285" width="440" height="85" as="geometry"/></mxCell>

        <mxCell id="asg" value="Auto Scaling Group&#xa;min=2 | desired=2 | max=4*&#xa;Launch Template + User Data&#xa;LabInstanceProfile" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2E8B70;fillColor=#D9F2E8;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="755" y="420" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="ec2a" value="EC2 t3.micro&#xa;Node.js / Express&#xa;Front + API :8080&#xa;EBS gp3 chiffré" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2E8B70;fillColor=#E8F7F1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="505" y="485" width="175" height="60" as="geometry"/></mxCell>
        <mxCell id="ec2b" value="EC2 t3.micro&#xa;Node.js / Express&#xa;Front + API :8080&#xa;EBS gp3 chiffré" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2E8B70;fillColor=#E8F7F1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="485" width="175" height="60" as="geometry"/></mxCell>

        <mxCell id="rds" value="Amazon RDS for MySQL&#xa;db.t3.micro | Single-AZ au départ&#xa;Privé | sauvegarde auto. 1 jour&#xa;Snapshot manuel avant destruction&#xa;SG-RDS : TCP 3306 depuis SG-App" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#527DB8;fillColor=#DCE9F9;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="625" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="dbnote" value="Groupe de sous-réseaux RDS sur 2 AZ; aucune instance de secours tant que Multi-AZ est désactivé. Restaurer depuis le dernier snapshot validé après redéploiement." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#42526E;" vertex="1" parent="1"><mxGeometry x="915" y="645" width="365" height="70" as="geometry"/></mxCell>

        <mxCell id="s3ep" value="Endpoint&#xa;passerelle S3&#xa;(route privée)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#8A6D3B;fillColor=#FFF1D6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1350" y="405" width="120" height="70" as="geometry"/></mxCell>
        <mxCell id="cwendpoint" value="Endpoints d’interface&#xa;CloudWatch Logs / Monitoring&#xa;(par AZ; coût à valider)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#9B59B6;fillColor=#F3E8F7;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1350" y="520" width="150" height="80" as="geometry"/></mxCell>

        <mxCell id="s3bucket" value="Amazon S3 — accès public bloqué&#xa;Bucket artefacts : archive app + configuration chiffrée&#xa;Bucket séparé : état Terraform partagé&#xa;Versionnement + chiffrement à activer" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#8A6D3B;fillColor=#FFF1D6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1580" y="300" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="cloudwatch" value="Amazon CloudWatch&#xa;Logs centralisés | tableau de bord&#xa;Alarmes : cibles ALB non saines&#xa;et CPU EC2 &gt; 80 % (à tester)" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#9B59B6;fillColor=#F3E8F7;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1580" y="485" width="320" height="105" as="geometry"/></mxCell>

        <mxCell id="budgets" value="AWS Budgets — à vérifier dans le Learner Lab&#xa;Alertes proposées : 45 USD (75 %) et 54 USD (90 %) du plafond de 60 USD&#xa;Confirmer la période; si bloqué : suivi manuel du crédit à chaque séance" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#C0504D;fillColor=#FCE8E6;fontSize=12;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="1580" y="650" width="320" height="100" as="geometry"/></mxCell>

        <mxCell id="client" value="Utilisateur&#xa;Navigateur Web" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#4A6FA5;fillColor=#EAF2F8;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="285" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="internet" value="Internet" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#607D8B;fillColor=#ECEFF1;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="235" y="295" width="120" height="55" as="geometry"/></mxCell>

        <mxCell id="iac" value="Plan de contrôle (hors VPC)&#xa;Terraform : plan / apply / destroy&#xa;Identifiants temporaires du Lab, jamais commités&#xa;Bootstrap séparé pour le bucket d’état S3" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#526D82;fillColor=#EAF0F5;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="natnote" value="Aucune NAT Gateway. Les dépendances sont empaquetées avant le déploiement; l’accès aux artefacts passe par l’endpoint S3. Toute solution de repli doit être validée et chiffrée." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C0504D;fillColor=#FFF4F2;fontSize=12;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="420" y="825" width="1110" height="80" as="geometry"/></mxCell>
        <mxCell id="footnote" value="* Plafond ASG initial proposé, à confirmer par test de charge. Le diagramme est une conception : aucune ressource AWS ni alerte n’est encore provisionnée." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#42526E;" vertex="1" parent="1"><mxGeometry x="30" y="930" width="1400" height="30" as="geometry"/></mxCell>

        <mxCell id="e1" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#34495E;fontSize=11;" edge="1" parent="1" source="client" target="internet"><mxGeometry relative="1" as="geometry"/></mxCell>
